# Apache config for shared hosting. Ignored by nginx (see README).

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  # Vite-hashed bundles never change under the same name
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  # Static assets from /public keep their names, so cache them for a month
  ExpiresByType model/gltf-binary "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>
